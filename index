      selectedColor: ACCENT_COLORS[0],
    };

    /* =====================================================================
     * 4. DYNAMIC APPLE TOUCH ICON GENERATOR (180x180 PNG via HTML5 Canvas)
     * ===================================================================== */
    function generateHubTouchIcon() {
      try {
        const size = 180;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        function roundRect(x, y, w, h, r) {
          ctx.beginPath();
          ctx.moveTo(x + r, y);
          ctx.arcTo(x + w, y, x + w, y + h, r);
          ctx.arcTo(x + w, y + h, x, y + h, r);
          ctx.arcTo(x, y + h, x, y, r);
          ctx.arcTo(x, y, x + w, y, r);
          ctx.closePath();
        }

        // Deep tactical slate-teal background gradient
        const grad = ctx.createLinearGradient(0, 0, size, size);
        grad.addColorStop(0, '#0f172a');
        grad.addColorStop(0.55, '#115e59');
        grad.addColorStop(1, '#0284c7');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, size, size);

        // Subtle grid accent lines
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(18, 18, size - 36, size - 36);

        // 2x2 Launcher Tiles
        const tiles = [
          { x: 40, y: 36, color: '#10b981' },
          { x: 96, y: 36, color: '#38bdf8' },
          { x: 40, y: 92, color: '#f59e0b' },
          { x: 96, y: 92, color: '#a78bfa' },
        ];

        tiles.forEach((t) => {
          ctx.save();
          ctx.shadowColor = 'rgba(0, 0, 0, 0.35)';
          ctx.shadowBlur = 10;
          ctx.shadowOffsetY = 4;
          roundRect(t.x, t.y, 44, 44, 12);
          ctx.fillStyle = t.color;
          ctx.fill();
          ctx.restore();

          roundRect(t.x + 11, t.y + 11, 22, 22, 5);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
          ctx.fill();
        });

        // Bottom Label
        ctx.fillStyle = '#f8fafc';
        ctx.font = '800 18px -apple-system, BlinkMacSystemFont, "PingFang HK", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('TOOLKIT HUB', size / 2, 156);

        const pngUrl = canvas.toDataURL('image/png');
        const appleLink = document.getElementById('appleTouchIconLink');
        const favLink = document.getElementById('faviconLink');
        if (appleLink) appleLink.href = pngUrl;
        if (favLink) favLink.href = pngUrl;
      } catch (e) {
        // Ignore if canvas dataURL is restricted
      }
    }

    /* =====================================================================
     * 5. UTILITIES & CLIPBOARD / EXPORT HELPERS
     * ===================================================================== */
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function showToast(message) {
      const container = document.getElementById('toastContainer');
      if (!container) return;
      const el = document.createElement('div');
      el.className = 'toast-msg';
      el.textContent = message;
      container.appendChild(el);
      requestAnimationFrame(() => el.classList.add('show'));
      setTimeout(() => {
        el.classList.remove('show');
        setTimeout(() => el.remove(), 220);
      }, 2500);
    }

    // Copy text reliably across mobile Safari, desktop, and sandboxed iframes
    function copyTextToClipboard(text, successMsg) {
      try {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length);
        const ok = document.execCommand('copy');
        document.body.removeChild(textarea);
        if (ok) {
          showToast(successMsg || 'Copied to clipboard');
          return true;
        }
      } catch (e) {
        // Fallback below
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(
          () => showToast(successMsg || 'Copied to clipboard'),
          () => showToast('Unable to copy automatically')
        );
      }
      return false;
    }

    function resolveFullUrl(relativeOrAbsolutePath) {
      try {
        return new URL(relativeOrAbsolutePath, window.location.href).href;
      } catch (e) {
        return relativeOrAbsolutePath;
      }
    }

    function persistLocalState() {
      try {
        localStorage.setItem(STORAGE_KEYS.TOOLS, JSON.stringify(state.tools));
        localStorage.setItem(STORAGE_KEYS.META, JSON.stringify(state.meta));
        state.hasLocalOverrides = true;
        updateSyncBannerVisibility();
      } catch (e) {
        showToast('Browser storage unavailable; remember to export index.html');
      }
    }

    /**
     * Builds a clean, self-contained HTML string of the current page with the
     * user's updated HUB_META and TOOLS array baked directly into the script.
     */
    function buildUpdatedHtmlSource() {
      // Clone current DOM so runtime UI modals/toasts/cards can be cleaned to initial state
      const clone = document.documentElement.cloneNode(true);

      // Reset runtime modal/toast/banner classes on the exported snapshot
      const modal = clone.querySelector('#manageModal');
      if (modal) modal.classList.remove('open');
      const banner = clone.querySelector('#localChangesBanner');
      if (banner) banner.classList.remove('visible');
      const toastBox = clone.querySelector('#toastContainer');
      if (toastBox) toastBox.innerHTML = '';
      const grid = clone.querySelector('#toolsGrid');
      if (grid) grid.innerHTML = '<!-- Cards rendered by JS -->';

      let fullHtml = '<!DOCTYPE html>\n' + clone.outerHTML;

      const configReplacement =
        `// /* HUB_CONFIG_START */\n` +
        `    const HUB_META = ${JSON.stringify(state.meta, null, 6).replace(/\n}$/, '\n    }')};\n\n` +
        `    const TOOLS = ${JSON.stringify(state.tools, null, 6).replace(/\n\]$/, '\n    ]')};\n` +
        `    // /* HUB_CONFIG_END */`;

      const configRegex = /\/\/ \/\* HUB_CONFIG_START \*\/[\s\S]*?\/\/ \/\* HUB_CONFIG_END \*\//;
      if (configRegex.test(fullHtml)) {
        fullHtml = fullHtml.replace(configRegex, configReplacement);
      }
      return fullHtml;
    }

    function exportUpdatedIndexHtmlFile() {
      const updatedSource = buildUpdatedHtmlSource();
      const blob = new Blob([updatedSource], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'index.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      showToast('Downloaded updated index.html — commit it to GitHub Pages!');
    }

    /* =====================================================================
     * 6. RENDERING FUNCTIONS
     * ===================================================================== */
    function updateSyncBannerVisibility() {
      const banner = document.getElementById('localChangesBanner');
      if (!banner) return;
      banner.classList.toggle('visible', state.hasLocalOverrides);
    }

    function renderHeaderMeta() {
      const titleEl = document.getElementById('hubTitleEl');
      const subEl = document.getElementById('hubSubtitleEl');
      const badgeEl = document.getElementById('toolCountBadge');

      if (titleEl) titleEl.textContent = state.meta.title || 'Web Toolkit Hub';
      if (subEl) subEl.textContent = state.meta.subtitle || '';
      if (badgeEl) {
        const count = state.tools.length;
        badgeEl.textContent = `${count} ${count === 1 ? 'tool' : 'tools'}`;
      }
      document.title = state.meta.title || 'Web Toolkit Hub';
    }

    function renderCategoryPills() {
      const container = document.getElementById('categoryPillsContainer');
      if (!container) return;

      const categories = ['All'];
      state.tools.forEach((tool) => {
        const cat = (tool.category || '').trim();
        if (cat && !categories.includes(cat)) {
          categories.push(cat);
        }
      });

      if (!categories.includes(state.activeCategory)) {
        state.activeCategory = 'All';
      }

      container.innerHTML = categories
        .map((cat) => {
          const isActive = cat === state.activeCategory;
          return `<button type="button" class="pill-btn ${isActive ? 'active' : ''}" data-category="${escapeHtml(cat)}">${escapeHtml(cat)}</button>`;
        })
        .join('');
    }

    function renderToolsGrid() {
      const grid = document.getElementById('toolsGrid');
      const emptyState = document.getElementById('emptyState');
      if (!grid || !emptyState) return;

      const query = state.searchQuery.trim().toLowerCase();

      const filtered = state.tools.filter((tool) => {
        const toolHref = tool.url || tool.path || '';
        const matchesCategory =
          state.activeCategory === 'All' || tool.category === state.activeCategory;
        if (!matchesCategory) return false;

        if (!query) return true;
        const haystack = [
          tool.title,
          tool.description,
          tool.category,
          toolHref,
          ...(Array.isArray(tool.tags) ? tool.tags : []),
        ]
          .join(' ')
          .toLowerCase();
        return haystack.includes(query);
      });

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.add('visible');
        return;
      }

      emptyState.classList.remove('visible');

      grid.innerHTML = filtered
        .map((tool) => {
          const iconHtml = renderToolIconContent(tool.icon);
          const accentColor = tool.color || '#0F766E';
          const toolHref = tool.url || tool.path || '#';
          const safePath = escapeHtml(toolHref);

          return `
            <article class="tool-card">
              <div>
                <div class="card-top">
                  <div class="card-icon-badge" style="background-color: ${escapeHtml(accentColor)};" aria-hidden="true">
                    ${iconHtml}
                  </div>
                  <div class="card-meta-right">
                    <span class="category-badge">${escapeHtml(tool.category || 'General')}</span>
                    <button type="button" class="card-edit-btn" data-action="edit-card" data-id="${escapeHtml(tool.id)}" title="Edit tool" aria-label="Edit ${escapeHtml(tool.title)}">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="card-body" style="margin-top:14px;">
                  <h2 class="card-title">${escapeHtml(tool.title)}</h2>
                  <p class="card-desc">${escapeHtml(tool.description || 'Single-file standalone HTML tool.')}</p>
                  <span class="card-file-path" title="${safePath}">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                    </svg>
                    ${safePath}
                  </span>
                </div>
              </div>

              <div class="card-actions">
                <a href="${safePath}" class="btn-open-tool">
                  <span>開啟工具 / Open</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7" />
                    <polyline points="7 7 17 7 17 17" />
                  </svg>
                </a>
                <button
                  type="button"
                  class="btn-copy-link"
                  data-action="copy-url"
                  data-path="${safePath}"
                  data-title="${escapeHtml(tool.title)}"
                  title="Copy full direct link to share"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                  <span>複製連結 / Copy URL</span>
                </button>
              </div>
            </article>
          `;
        })
        .join('');
    }

    /* =====================================================================
     * 7. MANAGE MODAL (ADD / EDIT / REORDER / DELETE)
     * ===================================================================== */
    function renderIconAndColorPickers() {
      const iconGrid = document.getElementById('iconPickerGrid');
      const colorRow = document.getElementById('colorPickerRow');

      if (iconGrid) {
        iconGrid.innerHTML = ICON_CHOICES
          .map((item) => {
            const selected = item.key === state.selectedIcon ? 'selected' : '';
            return `<button type="button" class="icon-choice-btn ${selected}" data-pick-icon="${escapeHtml(item.key)}" title="${escapeHtml(item.label)}" style="font-size:1.25rem;">${escapeHtml(item.key)}</button>`;
          })
          .join('');
      }

      if (colorRow) {
        colorRow.innerHTML = ACCENT_COLORS.map((hex) => {
          const selected = hex === state.selectedColor ? 'selected' : '';
          return `<button type="button" class="color-swatch-btn ${selected}" data-pick-color="${hex}" style="background-color:${hex};" aria-label="Color ${hex}"></button>`;
        }).join('');
      }
    }

    function renderManagedToolsList() {
      const container = document.getElementById('managedToolsContainer');
      if (!container) return;

      if (state.tools.length === 0) {
        container.innerHTML = `<p style="font-size:0.8rem; color:var(--text-muted); text-align:center; padding:12px;">No tools added yet. Use the form above to add one.</p>`;
        return;
      }

      container.innerHTML = state.tools
        .map((tool, index) => {
          const toolHref = tool.url || tool.path || '';
          return `
            <div class="managed-item">
              <div class="managed-item-info">
                <div class="managed-item-title">${escapeHtml(tool.title)}</div>
                <div class="managed-item-sub">${escapeHtml(toolHref)} · ${escapeHtml(tool.category)}</div>
              </div>
              <div class="managed-item-actions">
                <button type="button" class="mini-icon-btn" data-manage-action="up" data-index="${index}" ${index === 0 ? 'disabled style="opacity:0.35;"' : ''} title="Move up" aria-label="Move up">
                  ↑
                </button>
                <button type="button" class="mini-icon-btn" data-manage-action="down" data-index="${index}" ${index === state.tools.length - 1 ? 'disabled style="opacity:0.35;"' : ''} title="Move down" aria-label="Move down">
                  ↓
                </button>
                <button type="button" class="mini-icon-btn" data-manage-action="edit" data-id="${escapeHtml(tool.id)}" title="Edit" aria-label="Edit">
                  ✎
                </button>
                <button type="button" class="mini-icon-btn danger" data-manage-action="delete" data-id="${escapeHtml(tool.id)}" title="Remove" aria-label="Remove">
                  ✕
                </button>
              </div>
            </div>
          `;
        })
        .join('');
    }

    function resetToolFormToAddMode() {
      document.getElementById('editingToolId').value = '';
      document.getElementById('toolTitleInput').value = '';
      document.getElementById('toolPathInput').value = '';
      document.getElementById('toolCategoryInput').value = '';
      document.getElementById('toolTagsInput').value = '';
      document.getElementById('toolDescInput').value = '';
      state.selectedIcon = '🚌';
      state.selectedColor = ACCENT_COLORS[0];
      document.getElementById('formModeLabel').textContent = '+ Add New HTML Tool';
      document.getElementById('saveToolBtn').textContent = 'Add Tool to Hub';
      document.getElementById('cancelEditFormBtn').style.display = 'none';
      renderIconAndColorPickers();
    }

    function populateFormForEdit(toolId) {
      const tool = state.tools.find((t) => t.id === toolId);
      if (!tool) return;

      document.getElementById('editingToolId').value = tool.id;
      document.getElementById('toolTitleInput').value = tool.title || '';
      document.getElementById('toolPathInput').value = tool.url || tool.path || '';
      document.getElementById('toolCategoryInput').value = tool.category || '';
      document.getElementById('toolTagsInput').value = Array.isArray(tool.tags) ? tool.tags.join(', ') : '';
      document.getElementById('toolDescInput').value = tool.description || '';
      state.selectedIcon = tool.icon || '🛠️';
      state.selectedColor = tool.color || ACCENT_COLORS[0];

      document.getElementById('formModeLabel').textContent = `Editing: ${tool.title}`;
      document.getElementById('saveToolBtn').textContent = 'Update Tool';
      document.getElementById('cancelEditFormBtn').style.display = 'inline';
      renderIconAndColorPickers();
    }

    function openManageModal(editToolId = null) {
      document.getElementById('hubTitleInput').value = state.meta.title || '';
      document.getElementById('hubSubtitleInput').value = state.meta.subtitle || '';

      if (editToolId) {
        populateFormForEdit(editToolId);
      } else {
        resetToolFormToAddMode();
      }

      renderManagedToolsList();
      const modal = document.getElementById('manageModal');
      modal.classList.add('open');
    }

    function closeManageModal() {
      const modal = document.getElementById('manageModal');
      modal.classList.remove('open');
    }

    /* =====================================================================
     * 8. THEME TOGGLE & EVENT LISTENERS
     * ===================================================================== */
    function syncThemeIcons() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const sun = document.getElementById('iconSun');
      const moon = document.getElementById('iconMoon');
      const metaTheme = document.getElementById('themeColorMeta');

      if (sun && moon) {
        sun.style.display = current === 'dark' ? 'block' : 'none';
        moon.style.display = current === 'dark' ? 'none' : 'block';
      }
      if (metaTheme) {
        metaTheme.setAttribute('content', current === 'dark' ? '#090e1a' : '#f4f6f9');
      }
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem(STORAGE_KEYS.THEME, next);
      } catch (e) {
        // Ignore storage restrictions
      }
      syncThemeIcons();
    }

    function bindEvents() {
      // Theme toggle
      document.getElementById('themeToggleBtn').addEventListener('click', toggleTheme);

      // Search bar
      const searchInput = document.getElementById('searchInput');
      const clearBtn = document.getElementById('clearSearchBtn');

      searchInput.addEventListener('input', () => {
        state.searchQuery = searchInput.value;
        clearBtn.classList.toggle('visible', state.searchQuery.length > 0);
        renderToolsGrid();
      });

      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        state.searchQuery = '';
        clearBtn.classList.remove('visible');
        renderToolsGrid();
        searchInput.focus();
      });

      document.getElementById('resetFilterBtn').addEventListener('click', () => {
        searchInput.value = '';
        state.searchQuery = '';
        state.activeCategory = 'All';
        clearBtn.classList.remove('visible');
        renderCategoryPills();
        renderToolsGrid();
      });

      // Category filter pills
      document.getElementById('categoryPillsContainer').addEventListener('click', (e) => {
        const pill = e.target.closest('button[data-category]');
        if (!pill) return;
        state.activeCategory = pill.dataset.category;
        renderCategoryPills();
        renderToolsGrid();
      });

      // Tool cards delegation (Copy URL & quick Edit)
      document.getElementById('toolsGrid').addEventListener('click', (e) => {
        const copyBtn = e.target.closest('button[data-action="copy-url"]');
        if (copyBtn) {
          const fullUrl = resolveFullUrl(copyBtn.dataset.path);
          copyTextToClipboard(fullUrl, `Copied link for "${copyBtn.dataset.title}"`);
          return;
        }

        const editBtn = e.target.closest('button[data-action="edit-card"]');
        if (editBtn) {
          openManageModal(editBtn.dataset.id);
        }
      });

      // Header & Banner Export / Manage buttons
      document.getElementById('openManageModalBtn').addEventListener('click', () => openManageModal());
      document.getElementById('exportHubHeaderBtn').addEventListener('click', exportUpdatedIndexHtmlFile);
      document.getElementById('bannerExportBtn').addEventListener('click', exportUpdatedIndexHtmlFile);

      document.getElementById('bannerResetBtn').addEventListener('click', () => {
        try {
          localStorage.removeItem(STORAGE_KEYS.TOOLS);
          localStorage.removeItem(STORAGE_KEYS.META);
        } catch (e) {
          // Ignore
        }
        state.meta = { ...HUB_META };
        state.tools = TOOLS.map((t) => ({ ...t }));
        state.hasLocalOverrides = false;
        updateSyncBannerVisibility();
        renderHeaderMeta();
        renderCategoryPills();
        renderToolsGrid();
        showToast('Reset to embedded index.html defaults');
      });

      // Modal open/close
      document.getElementById('closeManageModalBtn').addEventListener('click', closeManageModal);
      document.getElementById('manageModal').addEventListener('click', (e) => {
        if (e.target.id === 'manageModal') closeManageModal();
      });

      // Hub title/subtitle live update inside modal
      document.getElementById('hubTitleInput').addEventListener('input', (e) => {
        state.meta.title = e.target.value.trim() || 'Web Toolkit Hub';
        persistLocalState();
        renderHeaderMeta();
      });

      document.getElementById('hubSubtitleInput').addEventListener('input', (e) => {
        state.meta.subtitle = e.target.value.trim();
        persistLocalState();
        renderHeaderMeta();
      });

      // Icon & Color pickers
      document.getElementById('iconPickerGrid').addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-pick-icon]');
        if (!btn) return;
        state.selectedIcon = btn.dataset.pickIcon;
        renderIconAndColorPickers();
      });

      document.getElementById('colorPickerRow').addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-pick-color]');
        if (!btn) return;
        state.selectedColor = btn.dataset.pickColor;
        renderIconAndColorPickers();
      });

      document.getElementById('cancelEditFormBtn').addEventListener('click', resetToolFormToAddMode);

      // Add / Edit Tool form submission
      document.getElementById('toolForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const editingId = document.getElementById('editingToolId').value.trim();
        const title = document.getElementById('toolTitleInput').value.trim();
        const url = document.getElementById('toolPathInput').value.trim();
        const category = document.getElementById('toolCategoryInput').value.trim() || 'Utilities';
        const description = document.getElementById('toolDescInput').value.trim();
        const tagsRaw = document.getElementById('toolTagsInput').value;
        const tags = tagsRaw
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean);

        if (!title || !url) return;

        if (editingId) {
          const idx = state.tools.findIndex((t) => t.id === editingId);
          if (idx !== -1) {
            state.tools[idx] = {
              ...state.tools[idx],
              title,
              url,
              category,
              description,
              tags,
              icon: state.selectedIcon,
              color: state.selectedColor,
            };
            delete state.tools[idx].path;
            showToast(`Updated "${title}"`);
          }
        } else {
          const slugId =
            title
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-|-$/g, '') || `tool-${Date.now()}`;

          state.tools.push({
            id: `${slugId}-${Date.now().toString(36)}`,
            title,
            description,
            category,
            url,
            icon: state.selectedIcon,
            color: state.selectedColor,
            tags,
          });
          showToast(`Added "${title}" to hub`);
        }

        persistLocalState();
        resetToolFormToAddMode();
        renderHeaderMeta();
        renderCategoryPills();
        renderToolsGrid();
        renderManagedToolsList();
      });

      // Managed tools reorder / edit / remove
      document.getElementById('managedToolsContainer').addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-manage-action]');
        if (!btn) return;
        const action = btn.dataset.manageAction;

        if (action === 'up' || action === 'down') {
          const idx = Number(btn.dataset.index);
          const targetIdx = action === 'up' ? idx - 1 : idx + 1;
          if (targetIdx < 0 || targetIdx >= state.tools.length) return;
          const temp = state.tools[idx];
          state.tools[idx] = state.tools[targetIdx];
          state.tools[targetIdx] = temp;
          persistLocalState();
          renderToolsGrid();
          renderManagedToolsList();
        } else if (action === 'edit') {
          populateFormForEdit(btn.dataset.id);
        } else if (action === 'delete') {
          const id = btn.dataset.id;
          const target = state.tools.find((t) => t.id === id);
          state.tools = state.tools.filter((t) => t.id !== id);
          if (document.getElementById('editingToolId').value === id) {
            resetToolFormToAddMode();
          }
          persistLocalState();
          renderHeaderMeta();
          renderCategoryPills();
          renderToolsGrid();
          renderManagedToolsList();
          if (target) showToast(`Removed "${target.title}"`);
        }
      });

      // Export & Copy Source Code buttons inside modal
      document.getElementById('downloadHtmlBtn').addEventListener('click', exportUpdatedIndexHtmlFile);
      document.getElementById('copySourceBtn').addEventListener('click', () => {
        const code = buildUpdatedHtmlSource();
        copyTextToClipboard(code, 'Copied full updated index.html code to clipboard');
      });
    }

    /* =====================================================================
     * 9. INITIALIZATION
     * ===================================================================== */
    function initHub() {
      generateHubTouchIcon();
      syncThemeIcons();

      // Load embedded defaults, then check if local browser customizations exist
      let loadedCustom = false;
      try {
        const savedToolsRaw = localStorage.getItem(STORAGE_KEYS.TOOLS);
        const savedMetaRaw = localStorage.getItem(STORAGE_KEYS.META);
        if (savedToolsRaw) {
          const parsedTools = JSON.parse(savedToolsRaw);
          if (Array.isArray(parsedTools)) {
            state.tools = parsedTools;
            loadedCustom = true;
          }
        }
        if (savedMetaRaw) {
          const parsedMeta = JSON.parse(savedMetaRaw);
          if (parsedMeta && typeof parsedMeta === 'object') {
            state.meta = { ...HUB_META, ...parsedMeta };
            loadedCustom = true;
          }
        }
      } catch (e) {
        // Fallback to embedded defaults
      }

      if (!loadedCustom) {
        state.meta = { ...HUB_META };
        state.tools = TOOLS.map((t) => ({ ...t }));
      } else {
        state.hasLocalOverrides = true;
      }

      bindEvents();
      updateSyncBannerVisibility();
      renderHeaderMeta();
      renderCategoryPills();
      renderToolsGrid();
    }

    window.addEventListener('DOMContentLoaded', initHub);
  </script>
</body>
