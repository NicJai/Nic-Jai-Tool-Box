      '#2563EB', // Royal Blue
      '#475569', // Slate
    ];

    const STORAGE_KEYS = {
      THEME: 'web_toolkit_theme_v1',
      TOOLS: 'web_toolkit_custom_tools_v2',
      META: 'web_toolkit_custom_meta_v2',
    };

    /* =====================================================================
     * 3. APPLICATION STATE
     * ===================================================================== */
