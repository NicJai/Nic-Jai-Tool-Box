<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <!-- iOS Safari Home Screen Standalone Web App Metadata -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Nicholas's Tools" />
  <meta name="theme-color" content="#0b1120" id="themeColorMeta" />
  <title>Nicholas's Web Tools</title>

  <!-- Dynamically generated 180x180 PNG Apple Touch Icon & Favicon -->
  <link id="appleTouchIconLink" rel="apple-touch-icon" sizes="180x180" href="" />
  <link id="faviconLink" rel="icon" type="image/png" href="" />

  <!-- Apply saved or system color theme immediately before first paint -->
  <script>
    (function initThemeEarly() {
      try {
        const saved = localStorage.getItem('web_toolkit_theme_v1');
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'dark'); // Default to dark tactical slate
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>

  <style>
    /* =====================================================================
     * 1. DESIGN TOKENS & THEME PALETTE (Tactical Slate Dark / Crisp Light)
     * ===================================================================== */
    :root {
      --bg-page: #f4f6f9;
      --bg-surface: #ffffff;
      --bg-surface-elevated: #f8fafc;
      --bg-header: rgba(255, 255, 255, 0.88);
      --border-subtle: rgba(15, 23, 42, 0.09);
      --border-strong: rgba(15, 23, 42, 0.16);
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --accent-primary: #0f766e;
      --accent-primary-hover: #115e59;
      --accent-soft: rgba(15, 118, 110, 0.1);
      --shadow-card: 0 2px 10px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.06);
      --shadow-card-hover: 0 12px 24px -6px rgba(15, 23, 42, 0.1), 0 4px 8px -2px rgba(15, 23, 42, 0.05);
      --shadow-modal: 0 24px 48px -12px rgba(15, 23, 42, 0.28);
      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang HK", "Noto Sans TC", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    }

    [data-theme="dark"] {
      --bg-page: #090e1a;
      --bg-surface: #111827;
      --bg-surface-elevated: #192234;
      --bg-header: rgba(17, 24, 39, 0.88);
      --border-subtle: rgba(148, 163, 184, 0.13);
      --border-strong: rgba(148, 163, 184, 0.24);
      --text-primary: #f1f5f9;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --accent-primary: #14b8a6;
      --accent-primary-hover: #2dd4bf;
      --accent-soft: rgba(20, 184, 166, 0.14);
      --shadow-card: 0 2px 10px rgba(0, 0, 0, 0.25), 0 1px 2px rgba(0, 0, 0, 0.35);
      --shadow-card-hover: 0 14px 28px -6px rgba(0, 0, 0, 0.48), 0 0 0 1px rgba(45, 212, 191, 0.25);
      --shadow-modal: 0 28px 56px -12px rgba(0, 0, 0, 0.72);
    }

    /* =====================================================================
     * 2. RESET & BASE LAYOUT
     * ===================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-family: var(--font-sans);
      background-color: var(--bg-page);
      color: var(--text-primary);
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-page);
      color: var(--text-primary);
      line-height: 1.5;
      overflow-x: hidden;
    }

    button, input, select, textarea {
      font: inherit;
      color: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* =====================================================================
     * 3. STICKY EXECUTIVE HEADER & CONTROLS
     * ===================================================================== */
    .app-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: var(--bg-header);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      padding-top: env(safe-area-inset-top);
    }

    .header-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .header-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .brand-logo {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(15, 118, 110, 0.28);
    }

    .brand-text {
      min-width: 0;
    }

    .brand-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-title {
      font-size: 1.125rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tool-count-pill {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent-primary);
      font-variant-numeric: tabular-nums;
      flex-shrink: 0;
    }

    .brand-subtitle {
      font-size: 0.78rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 38px;
      padding: 8px 13px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 700;
      transition: transform 0.12s ease, background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn-primary {
      background-color: var(--accent-primary);
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(15, 118, 110, 0.25);
    }

    [data-theme="dark"] .btn-primary {
      color: #042f2e;
    }

    .btn-primary:hover {
      background-color: var(--accent-primary-hover);
    }

    .btn-secondary {
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
    }

    .btn-secondary:hover {
      border-color: var(--border-strong);
      background-color: var(--bg-surface);
    }

    .btn-icon-only {
      width: 38px;
      padding: 0;
    }

    .btn-label-desktop {
      display: none;
    }

    @media (min-width: 600px) {
      .btn-label-desktop {
        display: inline;
      }
      .brand-title {
        font-size: 1.25rem;
      }
    }

    /* Search & Category Bar */
    .filter-controls {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    @media (min-width: 768px) {
      .filter-controls {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }

    .search-box {
      position: relative;
      flex: 1;
      max-width: 420px;
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      height: 40px;
      padding: 0 36px 0 36px;
      border-radius: var(--radius-sm);
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      font-size: 0.88rem;
      color: var(--text-primary);
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .search-input::placeholder {
      color: var(--text-muted);
    }

    .search-input:focus {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .search-clear-btn {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 24px;
      border-radius: 6px;
      color: var(--text-muted);
      display: none;
      align-items: center;
      justify-content: center;
    }

    .search-clear-btn.visible {
      display: flex;
    }

    .search-clear-btn:hover {
      background-color: var(--border-subtle);
      color: var(--text-primary);
    }

    .category-pills {
      display: flex;
      align-items: center;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .category-pills::-webkit-scrollbar {
      display: none;
    }

    .pill-btn {
      white-space: nowrap;
      padding: 6px 12px;
      min-height: 34px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      transition: all 0.15s ease;
    }

    .pill-btn:hover {
      border-color: var(--border-strong);
      color: var(--text-primary);
    }

    .pill-btn.active {
      background-color: var(--accent-primary);
      border-color: var(--accent-primary);
      color: #ffffff;
    }

    [data-theme="dark"] .pill-btn.active {
      color: #042f2e;
    }

    /* =====================================================================
     * 4. MAIN LAUNCH GRID & TACTILE TOOL CARDS
     * ===================================================================== */
    .main-container {
      flex: 1;
      width: 100%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 20px 16px calc(40px + env(safe-area-inset-bottom));
    }

    .sync-banner {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 16px;
      padding: 12px 16px;
      border-radius: var(--radius-md);
      background: var(--accent-soft);
      border: 1px solid var(--accent-primary);
      font-size: 0.82rem;
    }

    .sync-banner.visible {
      display: flex;
    }

    .sync-banner-text {
      color: var(--text-primary);
      font-weight: 600;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    @media (min-width: 640px) {
      .tools-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }
    }

    @media (min-width: 1024px) {
      .tools-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }
    }

    .tool-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      box-shadow: var(--shadow-card);
      transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
      position: relative;
    }

    .tool-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-card-hover);
      border-color: var(--border-strong);
    }

    .card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }

    .card-icon-badge {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 1.45rem;
      line-height: 1;
      color: #ffffff;
      box-shadow: 0 6px 14px -4px rgba(0, 0, 0, 0.25);
    }

    .card-meta-right {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .category-badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 8px;
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
    }

    .card-edit-btn {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .card-edit-btn:hover {
      background-color: var(--bg-surface-elevated);
      color: var(--text-primary);
    }

    .card-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--text-primary);
      line-height: 1.35;
    }

    .card-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .card-file-path {
      margin-top: 4px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--text-muted);
      background-color: var(--bg-surface-elevated);
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid var(--border-subtle);
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      align-self: flex-start;
    }

    .card-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-top: 4px;
      border-top: 1px solid var(--border-subtle);
    }

    .btn-open-tool {
      flex: 1;
      min-height: 40px;
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      border-radius: var(--radius-sm);
      font-size: 0.84rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.15s ease;
    }

    .btn-open-tool:hover {
      background-color: var(--accent-primary);
      border-color: var(--accent-primary);
      color: #ffffff;
    }

    [data-theme="dark"] .btn-open-tool:hover {
      color: #042f2e;
    }

    .btn-copy-link {
      min-height: 40px;
      padding: 0 12px;
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      border-radius: var(--radius-sm);
      font-size: 0.78rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: all 0.15s ease;
      flex-shrink: 0;
    }

    .btn-copy-link:hover {
      border-color: var(--border-strong);
      color: var(--text-primary);
      background-color: var(--bg-surface);
    }

    /* Empty Search State */
    .empty-state {
      text-align: center;
      padding: 56px 20px;
      background-color: var(--bg-surface);
      border: 1px dashed var(--border-strong);
      border-radius: var(--radius-lg);
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .empty-state.visible {
      display: flex;
    }

    .empty-state h3 {
      font-size: 1rem;
      font-weight: 800;
    }

    .empty-state p {
      font-size: 0.85rem;
      color: var(--text-muted);
      max-width: 360px;
    }

    /* =====================================================================
     * 5. FOOTER
     * ===================================================================== */
    .app-footer {
      border-top: 1px solid var(--border-subtle);
      padding: 18px 16px calc(24px + env(safe-area-inset-bottom));
      text-align: center;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .app-footer-inner {
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: center;
    }

    /* =====================================================================
     * 6. MODALS (Add / Edit Tools & Export Updated index.html)
     * ===================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 50;
      background-color: rgba(2, 6, 23, 0.68);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      display: none;
      align-items: flex-end;
      justify-content: center;
      padding: 0;
    }

    @media (min-width: 640px) {
      .modal-backdrop {
        align-items: center;
        padding: 16px;
      }
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-panel {
      width: 100%;
      max-width: 560px;
      max-height: 90vh;
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 24px 24px 0 0;
      box-shadow: var(--shadow-modal);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding-bottom: env(safe-area-inset-bottom);
    }

    @media (min-width: 640px) {
      .modal-panel {
        border-radius: 24px;
        padding-bottom: 0;
      }
    }

    .modal-header {
      padding: 18px 20px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-shrink: 0;
    }

    .modal-title {
      font-size: 1.05rem;
      font-weight: 800;
    }

    .modal-subtitle {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .modal-body {
      padding: 18px 20px;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    @media (min-width: 520px) {
      .form-grid-2 {
        grid-template-columns: 1fr 1fr;
      }
    }

    .form-field {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .form-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-secondary);
    }

    .form-control {
      width: 100%;
      padding: 9px 12px;
      border-radius: var(--radius-sm);
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      font-size: 0.88rem;
      color: var(--text-primary);
      outline: none;
    }

    .form-control:focus {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .icon-picker-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
    }

    .icon-choice-btn {
      height: 42px;
      border-radius: 10px;
      border: 1px solid var(--border-subtle);
      background-color: var(--bg-surface-elevated);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      transition: all 0.12s ease;
    }

    .icon-choice-btn.selected {
      border-color: var(--accent-primary);
      background-color: var(--accent-soft);
      color: var(--accent-primary);
      box-shadow: 0 0 0 2px var(--accent-soft);
    }

    .color-picker-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .color-swatch-btn {
      width: 32px;
      height: 32px;
      border-radius: 999px;
      border: 2px solid transparent;
      transition: transform 0.12s ease;
    }

    .color-swatch-btn.selected {
      transform: scale(1.14);
      box-shadow: 0 0 0 2px var(--bg-surface), 0 0 0 4px var(--text-primary);
    }

    .managed-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      border-top: 1px solid var(--border-subtle);
      padding-top: 14px;
    }

    .managed-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 12px;
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
    }

    .managed-item-info {
      min-width: 0;
      flex: 1;
    }

    .managed-item-title {
      font-size: 0.86rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .managed-item-sub {
      font-size: 0.74rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
    }

    .managed-item-actions {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-shrink: 0;
    }

    .mini-icon-btn {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
      background-color: var(--bg-surface);
    }

    .mini-icon-btn:hover {
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    .mini-icon-btn.danger:hover {
      color: #ef4444;
      border-color: rgba(239, 68, 68, 0.4);
    }

    .modal-footer {
